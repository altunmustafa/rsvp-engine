{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "format": {
      "cache": false
    },
    "format:check": {},
    "format:package-json": {
      "cache": false,
      "dependsOn": ["format"],
      "inputs": ["package.json"]
    },
    "format:package-json:check": {
      "inputs": ["package.json"]
    },
    "//#root:lint": {
      "inputs": [
        "**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
        "!packages/**",
        "!examples/**",
        "!node_modules/**",
        "!.turbo/**"
      ]
    },
    "//#root:format": {
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "!packages/**",
        "!examples/**",
        "!package.json",
        "!pnpm-lock.yaml"
      ]
    },
    "//#root:format:check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!packages/**",
        "!examples/**",
        "!package.json",
        "!pnpm-lock.yaml"
      ]
    },
    "//#root:format:package-json": {
      "cache": false,
      "inputs": ["package.json"]
    },
    "//#root:format:package-json:check": {
      "inputs": ["package.json"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "check:architecture": {},
    "check:size": {
      "dependsOn": ["build"]
    },
    "check:package": {
      "dependsOn": ["build"]
    }
  }
}
