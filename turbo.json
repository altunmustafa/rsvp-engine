{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "lint": {},
    "//#lint:root": {},
    "format": {
      "cache": false
    },
    "format:check": {},
    "//#format:package-json": {
      "cache": false
    },
    "//#format:package-json:check": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "check:architecture": {},
    "check:size": {
      "dependsOn": ["build"]
    },
    "check:package": {
      "dependsOn": ["build"]
    }
  }
}
