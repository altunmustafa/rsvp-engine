{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true
    },
    "start": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.js",
        "$TURBO_ROOT$/tsconfig.base.json"
      ]
    },
    "format": {
      "cache": false,
      "dependsOn": ["format:package-json"]
    },
    "format:check": {
      "dependsOn": ["format:package-json:check"]
    },
    "format:package-json": {
      "cache": false,
      "inputs": ["package.json"]
    },
    "format:package-json:check": {
      "inputs": ["package.json"]
    },
    "//#root:lint": {
      "inputs": [
        "**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
        "package.json",
        "!packages/**",
        "!fixtures/**",
        "!examples/**",
        "!node_modules/**",
        "!.turbo/**"
      ]
    },
    "//#root:format": {
      "cache": false,
      "dependsOn": ["//#root:format:package-json"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!packages/**",
        "!fixtures/**",
        "!examples/**",
        "!pnpm-lock.yaml"
      ]
    },
    "//#root:format:check": {
      "dependsOn": ["//#root:format:package-json:check"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!packages/**",
        "!fixtures/**",
        "!examples/**",
        "!pnpm-lock.yaml"
      ]
    },
    "//#root:format:package-json": {
      "cache": false,
      "inputs": ["package.json"]
    },
    "//#root:format:package-json:check": {
      "inputs": ["package.json"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "check:architecture": {},
    "check:size": {
      "dependsOn": ["build"]
    },
    "check:package": {
      "dependsOn": ["build"]
    },
    "verify": {
      "dependsOn": [
        "build",
        "format:check",
        "format:package-json:check",
        "lint",
        "typecheck",
        "//#root:format:check",
        "//#root:format:package-json:check",
        "//#root:lint"
      ]
    }
  }
}
