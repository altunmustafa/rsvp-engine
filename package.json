{
  "name": "rsvp-engine",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "changeset:publish": "turbo run build check:architecture check:size check:package && changeset publish",
    "changeset:version": "changeset version",
    "check:architecture": "turbo run check:architecture",
    "check:package": "turbo run check:package",
    "check:size": "turbo run check:size",
    "commitlint": "commitlint",
    "format": "turbo run format format:package-json \"//#root:format\" \"//#root:format:package-json\"",
    "format:check": "turbo run format:check format:package-json:check \"//#root:format:check\" \"//#root:format:package-json:check\"",
    "lint": "turbo run lint \"//#root:lint\"",
    "prepare": "husky",
    "root:format": "prettier . --write --ignore-path .gitignore --ignore-path .prettierignore",
    "root:format:check": "prettier . --check --ignore-path .gitignore --ignore-path .prettierignore",
    "root:format:package-json": "sort-package-json package.json",
    "root:format:package-json:check": "sort-package-json package.json --check",
    "root:lint": "eslint . --ignore-pattern \"packages/**\" --ignore-pattern \"examples/**\"",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm format:check && turbo run lint \"//#root:lint\" typecheck test:coverage check:architecture check:size check:package"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "eslint-plugin-tsdoc": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "prettier": "catalog:",
    "sort-package-json": "catalog:",
    "turbo": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "engines": {
    "node": "^22.12 || ^24 || >=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  }
}
