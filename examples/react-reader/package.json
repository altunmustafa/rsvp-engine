{
  "name": "@rsvp-engine/example-react-reader",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "format": "prettier . --write --ignore-path ../../.gitignore",
    "format:check": "prettier . --check --ignore-path ../../.gitignore",
    "format:package-json": "sort-package-json package.json",
    "format:package-json:check": "sort-package-json package.json --check",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rsvp-engine/react": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "sort-package-json": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
